# Copia este archivo como .env.local y llena los valores. NUNCA subas .env.local a Git.

# Tu WhatsApp: código de país + número, solo dígitos (sin +, espacios ni guiones).
# Para México: 52 seguido de tus 10 dígitos.
NEXT_PUBLIC_WHATSAPP=

# URL pública del sitio cuando lo publiques (para SEO). Ej.: https://hetor.dev (cuando ya sea tuyo y esté conectado)
NEXT_PUBLIC_SITE_URL=

# Opcional: token de GitHub (solo lectura de repos públicos) para subir el límite de peticiones.
# Se usa solo en el servidor; nunca se envía al navegador.
GITHUB_READ_TOKEN=
